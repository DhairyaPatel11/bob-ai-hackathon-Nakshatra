# =============================================================================
# ReadyLine - Environment Configuration
# =============================================================================

# --- Local IBM Granite via Ollama (ACTIVE OPERATIONAL PATH) ------------------
# Ollama OpenAI-compatible endpoint for local Granite 3.3 inference
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=granite3.3:2b

# --- IBM watsonx.ai Cloud (OPTIONAL ALTERNATIVE BACKEND) ----------------------
# If using IBM Cloud watsonx.ai instead of local Ollama, populate these:
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_uuid_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- Operational Settings ----------------------------------------------------
MISSION_WINDOW_CYCLES=20
RUL_CLAMP_THRESHOLD=125.0
